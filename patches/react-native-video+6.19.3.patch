+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  SloveCare patch (patch-package) — see patches/react-native-video+*.patch
+
+  PlayerView ka default surface_type "surface_view" hai, jo Android par window ke
+  PEECHE render hota hai — isliye uske upar text/overlay wale views video ko chhupa
+  dete the (background hero me video dikhti hi nahi thi). Yahan TextureView force kar
+  rahe hain taaki video view-hierarchy ke andar draw ho aur scrim/text uske upar aa sake.
+-->
+<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    app:surface_type="texture_view" />
